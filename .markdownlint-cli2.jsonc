{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD034": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD036": false,
    "MD040": false,
    "MD001": true,
    "MD022": true,
    "MD031": true,
    "MD032": true,
    "MD037": true,
    "MD038": true,
    "MD039": true,
    "MD046": false,
    "MD047": true,
    "MD050": true,
  },
  // Positive globs only. Exclusions MUST live in "ignores" below, never as
  // "!" negations here.
  //
  // Why: lint-staged passes ABSOLUTE file paths to markdownlint-cli2, which
  // appends them to these globs. In globby, a relative negation ("!docs/**")
  // cannot cancel an absolute positive match ("/repo/docs/foo.md"), so "!"
  // exclusions silently stop working inside the pre-commit hook while still
  // appearing to work for `npm run lint:markdown` (which passes no CLI args).
  //
  // "ignores" is immune: markdownlint-cli2 applies it AFTER file enumeration,
  // via micromatch against base-dir-relative paths, so both invocation paths
  // agree. See removeIgnoredFiles()/lintFiles() in markdownlint-cli2.js.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    // Authored prose and archived deliverables are exempt from lint. This
    // subsumes the former per-file "!docs/<name>.md" list and "docs/audit/**".
    "docs/**",
  ],
}
